# 复制成 .env 再填 key（.env 已被 .gitignore 忽略）
# W1 D2 要四家并排：deepseek / qwen / siliconflow / zhipu
# 零成本顺序：zhipu(GLM-4-Flash 免费) → siliconflow(注册送额度) → qwen(百炼免费额度) → deepseek(需充 ¥10)
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=

# 国内下载 HF 模型/数据集必须走镜像（huggingface.co 在这台机器上不通）
HF_ENDPOINT=https://hf-mirror.com
